class Solution {
    public int[] singleNum(int[] arr) {
        // Code here
        int a = 0;
        for(int i : arr){
            a ^= i;
        }
        a &= -a;
        int[] res = new int[2];
        for(int num : arr){
            if((num & a) == 0){
                res[0] ^= num;
            }
            else{
                res[1] ^= num;
            }
        }
        if(res[0] > res[1]){
            int temp = res[0];
            res[0] = res[1];
            res[1] = temp;
        }
        return res;
    }
}
