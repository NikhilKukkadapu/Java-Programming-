class Solution {
	int countTriplets(int sum, int arr[]) {
		// code here
		Arrays.sort(arr);
		int n = arr.length;
		int res = 0;
		for (int i = 0 ; i < n - 2 ; i++) {
			int j = i + 1, k = n - 1;
			while (j < k) {
				if ((arr[i] + arr[j] + arr[k]) >= sum) {
					k--;
				}
				else {
					res += (k - j);
					j++;
				}
			}
		}
		return res;
	}
}
