class Solution {
    public int findCeil(int[] arr, int x) {
        // code here
        int ans = -1;
        int left = 0 , right = arr.length - 1;
        while(left <= right){
            int mid = left + (right - left ) / 2;
            if(arr[mid] >= x){
                ans = mid;
                right = mid - 1;
            }
            else{
                left  = mid + 1;
            }
        }
        return ans;
    }
}
                               (OR)
class Solution {
    public int findCeil(int[] arr, int x) {
        // code here
        int ans = -1;
        for(int i = 0 ; i < arr.length ; i++){
            if(arr[i] >= x){
                ans = i;
                break;
            }
        }
        return ans;
    }
}
