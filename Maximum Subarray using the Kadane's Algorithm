class Solution {
    public int maxSubArray(int[] nums) {
        int currentSum = 0;
        int maxSum = nums[0];
        for(int num : nums){
            currentSum += num;
            maxSum = Math.max(maxSum,currentSum); 
            if(currentSum < 0){
                currentSum = 0;
            }
        }
        return maxSum;
    }
}
                     (OR)
class Solution {
    public int maxSubArray(int[] nums) {
        int maxSum = nums[0];
        for(int i = 0 ; i < nums.length ; i++){
            int sum = 0;
            for(int j = i ; j < nums.length ; j++){
                sum += nums[j];
                maxSum = Math.max(maxSum , sum);
            }
        }
        return maxSum;
    }
}
