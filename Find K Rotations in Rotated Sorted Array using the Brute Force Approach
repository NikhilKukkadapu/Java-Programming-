class Solution {
    public void rotate(int[] nums, int k) {
        int n = nums.length;
        for(int i = 0 ; i < k ; i++){
            int temp = nums[n-1];
            for(int j = n-2;j >= 0 ; j--){
                nums[j+1] = nums[j];
            }
            nums[0] = temp;
        }
    }
}


                            (OR)


class Solution {
    public void rotate(int[] nums, int k) {
        int n = nums.length;
        k = k % n;

        int temp[] = new int[n];

        
        for(int i = 0 ; i < n ; i++){
            int newIndex = (i+k) % n;
            temp[newIndex] = nums[i]; 
        }
        for(int i = 0 ; i < nums.length ; i++){
            nums[i] = temp[i];
        }
    }
}




                    
