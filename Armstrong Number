class Solution {
    static boolean armstrongNumber(int n) {
        // code here
        int temp = n;
        int sum = 0;
        while(n != 0){
            int a = n % 10;
            sum += (a * a * a);
            n /= 10;
        }
        if(temp != sum) return false;
        return true;
    }
}
