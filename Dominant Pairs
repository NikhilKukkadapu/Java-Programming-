class Solution {
    public int dominantPairs(int[] arr) {
        // Code here
        int n = arr.length;
        Arrays.sort(arr,0,n/2);
        Arrays.sort(arr,n/2,n);
        int count = 0;
        int right = n/2;
        for(int left = 0 ; left < n/2 ; left++){
            while(right < n && arr[left] >= 5 * arr[right]){
                right++;
            }
            count += right - n/2;
        }
        return count;
    }
}
